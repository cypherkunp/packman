{
  "name": "packman",
  "displayName": "Packman",
  "description": "Open package.json in a native-feeling UI with script runners and dependency intelligence.",
  "version": "0.0.1",
  "publisher": "cypherkunp",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCustomEditor:packman.packageJson",
    "onCommand:packman.openEditMode",
    "onCommand:packman.openUiMode",
    "onCommand:packman.openSocketSettings",
    "onCommand:packman.refreshEnrichment"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "packman.packageJson",
        "displayName": "Packman",
        "selector": [
          {
            "filenamePattern": "**/package.json"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "packman.openEditMode",
        "title": "Packman: Open Edit Mode",
        "icon": "$(go-to-file)"
      },
      {
        "command": "packman.openUiMode",
        "title": "Packman: Open UI Mode",
        "icon": "$(eye)"
      },
      {
        "command": "packman.openSocketSettings",
        "title": "Packman: Open Socket Settings"
      },
      {
        "command": "packman.refreshEnrichment",
        "title": "Packman: Refresh Enrichment",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "packman.openEditMode",
          "when": "activeCustomEditorId == packman.packageJson",
          "group": "navigation"
        },
        {
          "command": "packman.refreshEnrichment",
          "when": "activeCustomEditorId == packman.packageJson",
          "group": "navigation"
        },
        {
          "command": "packman.openUiMode",
          "when": "resourceFilename == package.json && activeCustomEditorId != packman.packageJson",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "packman.openEditMode",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m",
        "when": "activeCustomEditorId == packman.packageJson"
      },
      {
        "command": "packman.openUiMode",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m",
        "when": "resourceFilename == package.json && activeCustomEditorId != packman.packageJson"
      }
    ],
    "configuration": {
      "title": "Packman",
      "properties": {
        "packman.github.token": {
          "type": "string",
          "default": "",
          "markdownDescription": "Optional GitHub personal access token used to raise API rate limits when enriching Dependency rows (repo URL + open issues)."
        },
        "packman.socket.apiToken": {
          "type": "string",
          "default": "",
          "markdownDescription": "Socket.org API token (end-user). Required together with `#packman.socket.orgSlug#` to show Socket scores on Dependency rows."
        },
        "packman.socket.orgSlug": {
          "type": "string",
          "default": "",
          "markdownDescription": "Socket organization slug for `POST /orgs/{org}/purl`. Required together with `#packman.socket.apiToken#`."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "typecheck": "tsc -p ./ --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cypherkunp/packman.git"
  },
  "bugs": {
    "url": "https://github.com/cypherkunp/packman/issues"
  },
  "homepage": "https://github.com/cypherkunp/packman#readme",
  "devDependencies": {
    "@types/node": "^24.3.1",
    "@types/vscode": "^1.85.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
